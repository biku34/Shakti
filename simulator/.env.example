# Simulator config (SM-8). Copy to simulator/.env.
INGEST_URL="http://localhost:3000/api/ingest/readings"
# MUST match SIM_SERVICE_TOKEN in the Next.js .env.
SIM_SERVICE_TOKEN="change-me-simulator-token"

SIM_INTERVAL_MINUTES="15"   # meter reporting interval (sim minutes)
SIM_TICK_SECONDS="2"        # real seconds between pushes
SIM_ACCELERATION="96"       # sim minutes advanced per tick (96 → full day in ~30s)

SIM_HOST="0.0.0.0"
SIM_PORT="5001"
