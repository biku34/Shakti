# ─── MongoDB Atlas ────────────────────────────────────────────────
# Connection string for your Atlas cluster (SEC-5: server-only secret).
MONGODB_URI="mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/reip?retryWrites=true&w=majority"
MONGODB_DB="reip"

# ─── Auth (SEC-2) ─────────────────────────────────────────────────
# 32+ char random string used to sign session JWTs.
AUTH_SECRET="change-me-to-a-long-random-string"
SESSION_COOKIE="reip_session"
SESSION_TTL_HOURS="12"

# ─── Smart-meter ingestion (SEC-4, CI-3) ──────────────────────────
# Service token the Flask simulator presents on /api/ingest/readings.
SIM_SERVICE_TOKEN="change-me-simulator-token"

# ─── Blockchain: Polygon Amoy via Alchemy (BC-2, BC-3, SEC-6) ─────
# All chain access is server-side ONLY. Never expose these to the client.
ALCHEMY_API_KEY=""
ALCHEMY_NETWORK="polygon-amoy"
# Funded testnet account used to submit anchor transactions.
ANCHOR_PRIVATE_KEY=""
ANCHOR_FROM_ADDRESS=""
# Set to "true" to skip real chain calls and record mock tx hashes (offline demo).
BLOCKCHAIN_MOCK="true"

# ─── Pricing rule tuning (§9.1) ───────────────────────────────────
PRICING_BASE="5.75"          # midpoint of FiT and retail
PRICING_ALPHA="0.6"          # weight on demand/supply imbalance
PRICING_BETA="1.0"           # weight on congestion factor
PRICING_FIT_FLOOR="3.0"      # feed-in tariff floor (credits/kWh)
PRICING_RETAIL_CEILING="8.5" # retail ceiling (credits/kWh)

# ─── Future: Groq agentic layer (§9.3) ────────────────────────────
GROQ_API_KEY=""
